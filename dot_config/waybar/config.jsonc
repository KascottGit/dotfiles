{
    "reload_style_on_change": true,
    "layer": "bottom",
    /* No exclusive zone: Hyprland reserves the space instead (monitors.lua), so
       swaync's full-screen layer can cover the bar and block clicks on it */
    "exclusive": false,
    "position": "top",
    "height": 40,
    "margin-left": 40,
    "margin-right": 40,
    "passthrough": false,
    "gtk-layer-shell": true,
    "modules-left": [
        "clock",
        "custom/media",
        "battery",
        "power-profiles-daemon",
    ],
    "modules-center": [
        "group/workspaces"
    ],
    "modules-right": [
        "bluetooth",
        "pulseaudio",
        "network",
        "custom/notification",
        "custom/power"
    ],
    "bluetooth": {
        "format": "",
        "format-connected": "  {device_alias} ",
        "format-connected-battery": "  {device_alias} {device_battery_percentage}% ",
        "tooltip-format": "",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
        "on-click": "~/.config/waybar/scripts/popup.sh bluetui bluetui"
    },
    "clock": {
        "format": " {:%H:%M}",
        "interval": 1,
        "tooltip-format": "{:%Y-%m-%d}",
        "on-click": "~/.config/waybar/scripts/popup.sh calendar ~/.config/waybar/scripts/calendar.sh"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "{profile}",
        "format-icons": {
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": [
                "",
                "",
                "",
                ""
            ]
        },
        "tooltip-format": "{volume}%",
        "on-click": "~/.config/waybar/scripts/popup.sh pulsemixer pulsemixer"
    },
    "network": {
        "format": "{icon}",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "format-icons": {
            "wifi": [
                "󰤯",
                "󰤟",
                "󰤢",
                "󰤥",
                "󰤨"
            ],
            "ethernet": [
                ""
            ],
            "disconnected": [
                "󰯡"
            ]
        },
        "on-click": "~/.config/waybar/scripts/popup.sh nmtui ~/.config/waybar/scripts/nmtui.sh"
    },
    /* Built-in hyprland/workspaces can't switch on click with the Lua config, see scripts/workspace.sh */
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws#1",
            "custom/ws#2",
            "custom/ws#3",
            "custom/ws#4",
            "custom/ws#5",
            "custom/ws#6",
            "custom/ws#7",
            "custom/ws#8"
        ]
    },
    "custom/ws#1": {
        "exec": "~/.config/waybar/scripts/workspace.sh 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=1})'"
    },
    "custom/ws#2": {
        "exec": "~/.config/waybar/scripts/workspace.sh 2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=2})'"
    },
    "custom/ws#3": {
        "exec": "~/.config/waybar/scripts/workspace.sh 3",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=3})'"
    },
    "custom/ws#4": {
        "exec": "~/.config/waybar/scripts/workspace.sh 4",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=4})'"
    },
    "custom/ws#5": {
        "exec": "~/.config/waybar/scripts/workspace.sh 5",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=5})'"
    },
    "custom/ws#6": {
        "exec": "~/.config/waybar/scripts/workspace.sh 6",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=6})'"
    },
    "custom/ws#7": {
        "exec": "~/.config/waybar/scripts/workspace.sh 7",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=7})'"
    },
    "custom/ws#8": {
        "exec": "~/.config/waybar/scripts/workspace.sh 8",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=8})'"
    },
    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Low Battery'",
            "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
            "on-charging-100": "notify-send -u normal 'Battery Full!'"
        },
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ],
            "charging": [
                "󰢟",
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ]
        }
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    /* [TR] Güç Menüsü (Wlogout) / [EN] Power Menu (Wlogout) */
    "custom/power": {
        "format": "",
        "on-click": "pkill wlogout || wlogout -b 4 -c 0 -p layer-shell",
        "tooltip": false
    },
    /* [TR] Medya Oynatıcı Kontrolü / [EN] Media Player Control */
    "custom/media": {
        "format": " {}",
        "max-length": 30,
        "interval": 1,
        "exec": "playerctl metadata --format '{{ artist }} - {{ title }}'",
        "on-click": "~/.config/waybar/scripts/popup.sh media ~/.config/waybar/scripts/media.sh",
        "on-click-middle": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{}"
    }
}